{
  "name": "@whiletruefalse/forge",
  "version": "0.1.0",
  "description": "The execution boundary between your AI coding agent and production — sandbox, intercept, and review every operation before it's real.",
  "type": "module",
  "bin": {
    "forge": "./bin/forge.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whileTrueFalse/FORGE.git"
  },
  "homepage": "https://github.com/whileTrueFalse/FORGE#readme",
  "bugs": {
    "url": "https://github.com/whileTrueFalse/FORGE/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/clean-dist-tests.mjs",
    "forge": "tsx src/cli.ts",
    "test": "node scripts/test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "sandbox",
