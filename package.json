    "access": "public"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@electric-sql/pglite-socket": "^0.2.6",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ink": "^5.2.1",
    "js-yaml": "^4.2.0",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "react": "^18.3.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.31",
    "@types/uuid": "^10.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
